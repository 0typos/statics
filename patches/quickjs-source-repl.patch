+/* repl.js and standalone.js as source text, for qjs.c to compile at run
+   time. NUL-terminated, as JS_Eval requires; the sizes exclude the NUL. */
+#include <stdint.h>
+
+const uint8_t qjsc_repl[] = {
+#embed "repl.js"
+    , 0
+};
+const uint32_t qjsc_repl_size = sizeof(qjsc_repl) - 1;
+
+const uint8_t qjsc_standalone[] = {
+#embed "standalone.js"
+    , 0
+};
+const uint32_t qjsc_standalone_size = sizeof(qjsc_standalone) - 1;
