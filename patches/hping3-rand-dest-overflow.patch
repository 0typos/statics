hping3's --rand-dest parser reads up to four characters of each dotted
component into a four-byte buffer, then a terminating NUL past its end: a
one-byte stack overflow on input such as 1234.x.x.x, which Debian's patch
set leaves in place. Three characters hold any decimal octet or `x`. Not
specific to cross-compilation.

--- a/send.c
+++ b/send.c
@@ -41,7 +41,7 @@
 	unsigned char ra[4];
 	char a[4], b[4], c[4], d[4];
 
-	if (sscanf(targetname, "%4[^.].%4[^.].%4[^.].%4[^.]", a, b, c, d) != 4)
+	if (sscanf(targetname, "%3[^.].%3[^.].%3[^.].%3[^.]", a, b, c, d) != 4)
 	{
 		fprintf(stderr,
 			"wrong --rand-dest target host, correct examples:\n"
